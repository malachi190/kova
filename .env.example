# Copy to .env and replace the local placeholders with your own values.
NODE_ENV=development
DATABASE_URL=postgresql://kova_app:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/kova_dev
REDIS_URL=redis://127.0.0.1:6379
RABBITMQ_URL=amqp://kova_app:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5672/kova
PORT=3000
CORS_ORIGIN=http://localhost:3001

# Optional: required only for the integration migration test.
# Must connect to the local PostgreSQL maintenance database named "postgres".
# TEST_DATABASE_ADMIN_URL=postgresql://kova_test_admin:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/postgres
