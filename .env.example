# Copy to .env and replace the local placeholders with your own values.
NODE_ENV=development
DATABASE_URL=postgresql://kova_app:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/kova_dev
REDIS_URL=redis://127.0.0.1:6380
RABBITMQ_URL=amqp://kova_app:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5673/%2F
PORT=3000
CORS_ORIGIN=http://localhost:3001

# Local Compose credentials. Generate both passwords with `openssl rand -hex 24`.
COMPOSE_POSTGRES_DB=kova_dev
COMPOSE_POSTGRES_USER=kova_app
COMPOSE_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
COMPOSE_POSTGRES_PORT=55432
COMPOSE_REDIS_PORT=6380
COMPOSE_RABBITMQ_USER=kova_app
COMPOSE_RABBITMQ_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
COMPOSE_RABBITMQ_PORT=5673
COMPOSE_RABBITMQ_MANAGEMENT_PORT=15673
COMPOSE_MAILPIT_SMTP_PORT=1026
COMPOSE_MAILPIT_UI_PORT=8026

# Optional: required only for the integration migration test.
# Must connect to the local PostgreSQL maintenance database named "postgres".
# The generated kova_app role in the local Compose database can create test databases.
# TEST_DATABASE_ADMIN_URL=postgresql://kova_app:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/postgres
