{
  "name": "kova",
  "version": "0.1.0",
  "private": true,
  "description": "Kova escrow platform application",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@11.28.11",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts' '*.ts' '*.{json,mjs}' pnpm-workspace.yaml",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts' '*.ts' '*.{json,mjs}' pnpm-workspace.yaml",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && tsc -p tsconfig.test.json && node --env-file-if-exists=.env --test dist/test/*/*.test.js && jest --config jest.unit.config.cjs --coverage",
    "test:smoke": "pnpm build && tsc -p tsconfig.test.json && node --env-file-if-exists=.env --test dist/test/smoke/*.test.js",
    "test:integration": "pnpm build && tsc -p tsconfig.test.json && node --env-file-if-exists=.env --test dist/test/integration/*.test.js && node dist/test/helpers/run-testcontainers.js jest.integration.config.cjs --coverage",
    "test:e2e": "pnpm build && tsc -p tsconfig.test.json && node dist/test/helpers/run-testcontainers.js jest.e2e.config.cjs --coverage",
    "db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
    "start:api": "node --env-file-if-exists=.env dist/src/main.api.js",
    "start:worker": "node --env-file-if-exists=.env dist/src/main.worker.js",
    "start:scheduler": "node --env-file-if-exists=.env dist/src/main.scheduler.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/throttler": "6.7.1",
    "amqplib": "2.2.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.4",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "redis": "6.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/rabbitmq": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "type": "commonjs"
}
