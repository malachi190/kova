{
  "name": "kova",
  "version": "0.1.0",
  "private": true,
  "description": "Kova escrow platform application",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@11.28.11",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts' '*.{json,mjs}'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts' '*.{json,mjs}'",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:smoke",
    "test:smoke": "pnpm build && tsc -p tsconfig.test.json && node --test dist/test/smoke/*.test.js",
    "start:api": "node dist/src/main.api.js",
    "start:worker": "node dist/src/main.worker.js",
    "start:scheduler": "node dist/src/main.scheduler.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "type": "commonjs"
}
